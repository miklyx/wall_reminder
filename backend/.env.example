# Copy to .env locally; do not commit the real .env.
REMINDER_API_KEY=replace-with-a-long-random-secret
# Local SQLite path; Docker Compose overrides this with /data/reminders.sqlite3.
REMINDER_DB_PATH=./reminders.sqlite3
# Absolute path on the Docker host to the Firebase Admin SDK private-key JSON.
FIREBASE_ADMIN_KEY_FILE=/absolute/secure/path/firebase-adminsdk.json
# Optional for running FastAPI outside Docker; the same credentials file can be used.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/secure/path/firebase-adminsdk.json
# Firebase Console project ID (must match the app and Admin SDK credentials).
GOOGLE_CLOUD_PROJECT=wall-reminder-161
REMINDER_PORT=8000
REMINDER_POLL_SECONDS=1
REMINDER_RETRY_SECONDS=30
FCM_RETRY_SECONDS=300
